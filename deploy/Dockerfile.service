# 운영 웹 서비스 (Flask + gunicorn). 빌드 컨텍스트: 저장소 루트
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY webservice/requirements-prod.txt ./
RUN pip install -r requirements-prod.txt
COPY webservice/app ./app
COPY webservice/run.py .
ENV DATABASE_URL=sqlite:////data/app.db CERT_STORAGE_DIR=/data/certs
RUN mkdir -p /data
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=3)"
# SQLite 는 동시 쓰기에 약하므로 워커 1개 + 스레드
CMD ["gunicorn", "-b", "0.0.0.0:8000", "-w", "1", "--threads", "4", "--access-logfile", "-", "run:app"]
